SHOPIFY_STORE_DOMAIN=ahim-cohenn.myshopify.com
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-10
SHOPIFY_METAFIELD_IDENTIFIERS=
# Shopify Admin access for managed bundles (write_products and write_publications).
# Use a store-specific token or the installed app's credentials.
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Full gid://shopify/Publication/... of the storefront sales channel.
SHOPIFY_BUNDLE_PUBLICATION_ID=
# Supabase Data API used on the server for bundle mappings and product reviews.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Signing secret of the orders/paid webhook (not the Storefront token).
SHOPIFY_WEBHOOK_SECRET=
# Durable shared storage for authenticated payment confirmations.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional stable signing secret. Falls back to the private Storefront token.
SHOPIFY_CHECKOUT_STATUS_SECRET=
# Customer email OTP. Use the publishable key from the same project as SUPABASE_URL.
# Enable email signups, include {{ .Token }} in Confirm signup and Magic Link,
# and configure a production SMTP sender in Supabase Authentication.
SUPABASE_PUBLISHABLE_KEY=
